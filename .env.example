# Copy to .env (git-ignored) and fill in. Never commit real values.
# Leave MONGODB_URI empty to run fully offline on the local JSON store.
MONGODB_URI=
MONGODB_DB=hygieia

# Replay engine (optional)
REPLAY_SECONDS_PER_SLOT=5
REPLAY_START_DAY=79
REPLAY_AUTOPLAY=1

# AI Chat (optional). Without a key the chat uses the offline demo answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
